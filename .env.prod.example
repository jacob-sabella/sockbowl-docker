# Production environment (WP-D2, plans/m7-deploy.md §4.3). A COMPLETE env
# file — copy this to `.env` in the deploy bundle (/home/ubuntu/sockbowl-prod,
# never sockbowl-docker) and fill every CHANGE_ME_* value.
# scripts/deploy/make-env.sh (WP-D3) does most of that on the VPS itself,
# generating fresh secrets or carrying named ones over from the old stack's
# .env.alpha, and is never given anything to print back out. No real secret
# value appears in this file, and nothing here is ever echoed by any deploy
# script.
#
# Used as: docker compose --env-file .env -f docker-compose.yml \
#   -f docker-compose.prod.yml --profile full up -d
#
# Sections not repeated below (RL/quota per-policy overrides) keep the
# .env.example defaults documented there — uncomment the ones you actually
# want to change, exactly as in dev.

# --- Identity ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=sockbowl-prod
# The single public origin (D22): scheme://host, no path, no trailing slash.
# Drives the Keycloak client's only redirect URI/web origin/post-logout URI
# (D1 exact-set reconcile), sockbowl-ng's path mode (N1), and the CORS
# origins below. Never set SOCKBOWL_EXTRA_REDIRECT_ORIGINS in prod (that's
# dev-only, docker-compose.dev.yml).
SOCKBOWL_PUBLIC_URL=https://sockbowl.jacobsabella.com
# The aa-web bridge network the existing aa-caddy reverse proxy (and mage-*)
# already run on (D25). docker-compose.prod.yml joins it as an EXTERNAL
# network — it must already exist; this stack never creates or removes it.
SOCKBOWL_EDGE_NETWORK=aa-web_default
# Container aliases on that network are "${SOCKBOWL_EDGE_PREFIX}-<service>"
# (e.g. sockbowl-prod-game), so the real deploy and any throwaway rehearsal
# project (V1: sbm7v, or a WP's sbm7-<wp>) can share one edge network without
# their aliases colliding. Must match the EDGE_PREFIX given to
# scripts/deploy/render-caddy.sh for the same deploy.
SOCKBOWL_EDGE_PREFIX=sockbowl-prod
# The exact, ANCHORED address of aa-caddy's own peer identity on
# SOCKBOWL_EDGE_NETWORK (D26) — never a broad subnet, and never a Cloudflare
# IP range directly (aa-caddy, not Cloudflare, is the actual TCP peer
# game/questions see). A preflight step (WP-D3) derives this from
# `docker network inspect ${SOCKBOWL_EDGE_NETWORK}`'s subnet/aa-caddy's
# address; it is written here as a single fully-anchored regex, e.g.
# ^172\.21\.0\.2$ for one fixed address, or ^172\.21\.0\.\d{1,3}$ only if
# aa-caddy's address genuinely varies within that /24 — never leave this
# un-anchored (a bare `172\.21` would also match 172.210.0.0/16) and never
# widen it to "the whole edge subnet" without checking who else is on it.
# docker-compose.prod.yml passes this to game/questions under both the M7
# name (SOCKBOWL_INTERNAL_PROXIES) and this M4-era name.
SOCKBOWL_TRUSTED_PROXIES_REGEX=CHANGE_ME_ANCHORED_AA_CADDY_REGEX
# Compose is production-capable by default (D9); keep this true. AUTH_ENABLED
# =false is a local-dev-only escape hatch and must never be used here.
AUTH_ENABLED=true

# --- Container-internal listen ports (unaffected by bridge networking: each
# app still binds this port INSIDE its own container; sibling containers
# reach it at "<service-name>:<port>", never a host port) -------------------
KEYCLOAK_PORT=8080
SOCKBOWL_GAME_PORT=7000
SOCKBOWL_QUESTIONS_PORT=7009
POSTGRES_PORT=5432
NEO4J_PORT=7687
KAFKA_PORT=9092
REDIS_PORT=6379
# Not used for public addressing in prod (SOCKBOWL_PUBLIC_URL/KEYCLOAK_INTERNAL_URL
# below own that), but a handful of container-internal defaults still fall
# back to these if unset, so they're kept defined rather than left blank.
APP_HOST=sockbowl.jacobsabella.com
APP_PROTOCOL=https
WS_PROTOCOL=wss

# --- Internal addressing (bridge network, §4.1) -----------------------------
# SOCKBOWL_INTERNAL_HOST is deliberately left UNSET here: docker-compose.prod.yml
# points kafka/redis/postgres/neo4j straight at their Compose service names
# instead (see that file's header comment) — a single shared "internal host"
# can't address four differently-named services on a bridge network the way
# it could when they were all "localhost" under host-network dev. Keycloak's
# admin API, JWKS and client-credentials token endpoint still resolve through
# this one variable (the base file already substitutes it):
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
# What Kafka advertises to clients on `internal` (must be its own Compose name).
KAFKA_ADVERTISED_HOST=kafka
# game -> questions base URL on `internal`.
SOCKBOWL_QUESTIONS_INTERNAL_URL=http://sockbowl-questions:7009/

# --- Images (§4.4) -----------------------------------------------------------
# Built locally and docker-loaded (O11); never :main, never :latest. Set by
# scripts/deploy/ship-images.sh after a build from the verified goal/m7-deploy
# heads — fill the real short shas before `up`.
SOCKBOWL_GAME_IMAGE=sockbowl-game:m7-CHANGE_ME_SHA
SOCKBOWL_QUESTIONS_IMAGE=sockbowl-questions:m7-CHANGE_ME_SHA
SOCKBOWL_NG_IMAGE=sockbowl-ng:m7-CHANGE_ME_SHA

# --- Secrets (CHANGE_ME_*; scripts/check-secrets.sh refuses every one of
# these placeholders — the stack will not start until they're replaced) ------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
# DK-3. Same value reaches redis, sockbowl-game and sockbowl-questions (one
# shared Redis instance/db — see docker-compose.yml's DK-3 comments); no
# separate per-service variable exists. A-Z a-z 0-9 . _ ~ + = / - only
# (scripts/redis-start.sh), e.g. `openssl rand -hex 32`. Required: unlike the
# dev overlay, the prod overlay supplies no dev-only fallback, and
# ALLOW_INSECURE_DEFAULTS must stay false (below), so an empty value here
# fails closed rather than silently running Redis without auth.
SOCKBOWL_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
SOCKBOWL_GAME_BACKEND_SECRET=CHANGE_ME_GAME_BACKEND_SECRET
KEYCLOAK_USER_USERNAME=admin
KEYCLOAK_USER_EMAIL=admin@sockbowl.com
KEYCLOAK_USER_FIRSTNAME=Admin
KEYCLOAK_USER_LASTNAME=User
KEYCLOAK_USER_PASSWORD=CHANGE_ME_KEYCLOAK_USER_PASSWORD
# D28: keep Google login; no value here is Google-specific (the broker's
# client secret lives inside the migrated Keycloak DB, not in this file).
# D24/O13: the old prod OpenAI key, carried over.
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# --- Keycloak (§3.5) ---------------------------------------------------------
# The public issuer every access token carries (`iss`), and what game and
# questions validate against — always the PUBLIC URL, even though JWKS/token
# fetches themselves go over KEYCLOAK_INTERNAL_URL above (§3.5:
# hostname-backchannel-dynamic defaults to false, so `iss` never changes
# depending on who's asking).
KEYCLOAK_ISSUER_URI=${SOCKBOWL_PUBLIC_URL}/auth/realms/sockbowl
KEYCLOAK_PUBLIC_URL=${SOCKBOWL_PUBLIC_URL}/auth
SOCKBOWL_AUTH_AUDIENCE=sockbowl-api
KC_ACCESS_TOKEN_LIFESPAN=300

# --- Sockbowl Game Service ---------------------------------------------------
SOCKBOWL_DATABASE=0
SOCKBOWL_KAFKA_GAME_TOPIC=game-session-topic
# Superseded by docker-compose.prod.yml, which sets both services' allowed
# origins straight from SOCKBOWL_PUBLIC_URL; kept here at the same value only
# so `docker compose config` has nothing left unset to warn about.
SOCKBOWL_GAME_ALLOWED_ORIGINS=${SOCKBOWL_PUBLIC_URL}
SOCKBOWL_QUESTIONS_ALLOWED_ORIGINS=${SOCKBOWL_PUBLIC_URL}

# --- Sockbowl Questions / AI (§3.4/H6, O13: carry the old prod OpenAI
# settings over — there is no Ollama on the VPS) ------------------------------
SOCKBOWL_AI_PROVIDER=openai
SOCKBOWL_AI_LOCAL_MODEL=
SPRING_AI_OPENAI_CHAT_ENABLED=true
SPRING_AI_OLLAMA_CHAT_ENABLED=false
SPRING_AI_OLLAMA_BASE_URL=
SPRING_AI_OLLAMA_CHAT_OPTIONS_MODEL=
# Proven by WP-Q1's OldProdAiEnvironmentBootIT: with these three set and a
# real OPENAI_API_KEY, questions boots on OpenAI chat+embeddings with zero
# Ollama beans and no Neo4jVectorStoreAutoConfiguration Ollama-embedding path.
# The base compose file has no passthrough for these three (added by
# docker-compose.prod.yml's sockbowl-questions block, since questions' Ollama
# embedding path needed no chat/embedding-model env at all before M7).
SPRING_AI_MODEL_CHAT=openai
SPRING_AI_MODEL_EMBEDDING=openai
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.ai.vectorstore.neo4j.autoconfigure.Neo4jVectorStoreAutoConfiguration
# DK-1 JVM caps carried over from the old prod override (see the "Memory
# limits" section below for the matching SOCKBOWL_QUESTIONS_MEM_LIMIT).
SOCKBOWL_QUESTIONS_JAVA_TOOL_OPTIONS=
SOCKBOWL_QUESTIONS_JVM_THREAD_COUNT=250

# --- Prod-safe flags ----------------------------------------------------------
CREATE_DEMO_ACCOUNTS=false
SOCKBOWL_E2E=false
ALLOW_INSECURE_DEFAULTS=false

# --- Rate limiting / quotas ----------------------------------------------------
# The plan's prod defaults (plans/m4-limits.md §2.2 / .env.example) are kept
# as-is: every SOCKBOWL_RL_*/SOCKBOWL_QUOTA_* override stays commented out
# there and is not repeated here. D26/O2 chose the Cloudflare proxy + AOP
# (option A), which restores real per-IP identity via CF-Connecting-IP, so
# O2 option C's "raise the per-IP capacities, IP bans are ineffective" advice
# does NOT apply here — leave the shipped per-IP defaults alone.
SOCKBOWL_RATELIMIT_ENABLED=true
SOCKBOWL_QUOTA_ENABLED=true
SOCKBOWL_AI_SERVER_DAILY_BUDGET=200

# --- Memory limits (DK-1; .env.example has the full sizing rationale and the
# in-process cap that must go with each one) -----------------------------------
SOCKBOWL_KAFKA_MEM_LIMIT=640m
KAFKA_HEAP_OPTS=-Xms384m -Xmx384m
SOCKBOWL_POSTGRES_MEM_LIMIT=256m
SOCKBOWL_REDIS_MEM_LIMIT=192m
SOCKBOWL_REDIS_MAXMEMORY=128mb
SOCKBOWL_NEO4J_MEM_LIMIT=1100m
NEO4J_server_memory_heap_initial__size=512m
NEO4J_server_memory_heap_max__size=512m
NEO4J_server_memory_pagecache_size=384m
SOCKBOWL_KEYCLOAK_MEM_LIMIT=900m
SOCKBOWL_GAME_MEM_LIMIT=700m
SOCKBOWL_GAME_JVM_THREAD_COUNT=250
SOCKBOWL_GAME_JAVA_TOOL_OPTIONS=
SOCKBOWL_QUESTIONS_MEM_LIMIT=750m
SOCKBOWL_NG_MEM_LIMIT=64m

# --- sockbowl-ng CSP -----------------------------------------------------------
CSP_EXTRA_CONNECT_SRC=https://api.openai.com

# --- Watchtower / Docker socket -------------------------------------------------
# Unused: docker-compose.prod.yml keeps watchtower out of the "full" profile
# entirely (D25, a second watchtower on this shared host would collide with
# the existing mage-watchtower). Kept only so the base file's `${DOCKER_SOCKET_PATH
# :-/var/run/docker.sock}` substitution has no "unset" warning if anything
# ever renders that service's config without the prod overlay by mistake.
DOCKER_SOCKET_PATH=/var/run/docker.sock
