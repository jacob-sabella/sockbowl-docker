# Centralized host configuration
# Change this to your domain/IP for production deployments
APP_HOST=localhost

# Compose project name. Normally you don't need to set this: Compose resolves
# it from the `-p` flag (see README.md "Usage") or the working directory name,
# and this variable just exposes that resolved name back to the compose file
# itself, for two things that need a stable per-project identifier:
#   - watchtower's WATCHTOWER_SCOPE and each app container's
#     com.centurylinklabs.watchtower.enable/scope labels, so one host running
#     several `-p` projects at once doesn't have every project's watchtower
#     update every other project's containers (see "Watchtower" below).
# Leave unset unless you have a specific reason to pin it independently of `-p`.
#COMPOSE_PROJECT_NAME=sockbowl

# Protocol settings
# For production with HTTPS, change to:
# APP_PROTOCOL=https
# WS_PROTOCOL=wss
APP_PROTOCOL=http
WS_PROTOCOL=ws

# Public vs internal addresses (M7, plans/m7-deploy.md §3.2). All four are
# commented out: the defaults reproduce the host-network values above, so
# local dev needs none of them. The prod overlay (docker-compose.prod.yml)
# points the internal ones at compose service names.
#
# The browser-facing origin, scheme://host[:port] with no path and no trailing
# slash. Default: ${APP_PROTOCOL}://${APP_HOST}. It is the ONLY redirect URI /
# web origin / post-logout URI the sockbowl-game Keycloak client gets (rbac-init
# removes any other). Setting it also switches sockbowl-ng to single-host path
# mode (/api, /ws, /questions, /auth), so leave it unset for port-mode dev.
#SOCKBOWL_PUBLIC_URL=https://sockbowl.jacobsabella.com
# Extra allowed origins for the sockbowl-game client, space-separated, same
# format. Dev only: docker-compose.dev.yml sets the :4200 and game-port origins.
#SOCKBOWL_EXTRA_REDIRECT_ORIGINS=http://localhost:4200 http://localhost:7000
# Where containers reach Kafka, Redis, Postgres and Neo4j (default ${APP_HOST}).
#SOCKBOWL_INTERNAL_HOST=localhost
# Where containers reach Keycloak for the admin API, JWKS and client-credentials
# tokens (default http://${APP_HOST}:${KEYCLOAK_PORT}). The token issuer stays
# KEYCLOAK_ISSUER_URI (public) either way.
#KEYCLOAK_INTERNAL_URL=http://localhost:8080
# What Kafka advertises to its clients (default localhost).
#KAFKA_ADVERTISED_HOST=localhost
# game -> questions base URL (default
# ${APP_PROTOCOL}://${SOCKBOWL_INTERNAL_HOST}:${SOCKBOWL_QUESTIONS_PORT}/).
#SOCKBOWL_QUESTIONS_INTERNAL_URL=http://localhost:7009/
#
# The two below are read only by docker-compose.prod.yml (the bridge-network
# overlay), never by this file's host-network services; see .env.prod.example
# for the full description and real example values (aa-web_default /
# sockbowl-prod). Left unset here since dev never loads that overlay.
#SOCKBOWL_EDGE_NETWORK=aa-web_default
#SOCKBOWL_EDGE_PREFIX=sockbowl-prod

# Port configuration (for reference, services use host networking)
KEYCLOAK_PORT=8080
SOCKBOWL_GAME_PORT=7000
SOCKBOWL_QUESTIONS_PORT=7009
POSTGRES_PORT=5432
NEO4J_PORT=7687
KAFKA_PORT=9092
REDIS_PORT=6379

# Database credentials
# CHANGE_ME_* placeholders: docker-compose.yml (the production-capable default)
# refuses to start with these (see scripts/check-secrets.sh, AUTH-05). Set
# real values before deploying. Local/e2e use via docker-compose.dev.yml sets
# ALLOW_INSECURE_DEFAULTS=true and doesn't need you to change them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# The database name Postgres creates on first boot (the `postgres` service's
# own POSTGRES_DB is hardcoded to this same default and does not read this
# variable — it's read here only by the healthcheck's `pg_isready -d`, so
# leave it matching unless you've also changed the service's own init).
#POSTGRES_DB=sockbowl
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
# Redis password (DK-3). Required: the redis service refuses to start without
# one, or with this placeholder (scripts/redis-start.sh + check-secrets.sh).
# game and questions receive the same value. Use only A-Z a-z 0-9 . _ ~ + = / -
# (e.g. `openssl rand -hex 32`). docker-compose.dev.yml supplies a dev-only
# default when this is unset; setting it explicitly EMPTY under the dev overlay
# runs Redis without auth (only for app images that predate this variable).
# Redis also binds loopback only on this host-network file:
#SOCKBOWL_REDIS_BIND=127.0.0.1 -::1
SOCKBOWL_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Keycloak configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/sockbowl
# The externally reachable Keycloak URL. In production this must match the
# host the reverse proxy fronts Keycloak on (KC_HOSTNAME, strict hostname
# checking); a mismatch fails issuer validation everywhere (see README).
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Shared secret the sockbowl-game backend uses for its confidential Keycloak client
# (used by scripts/load-rbac.sh when upserting the RBAC model)
SOCKBOWL_GAME_BACKEND_SECRET=CHANGE_ME_GAME_BACKEND_SECRET

# The audience every game/questions-bound access token must carry (checked by
# both services' JWT validators; see docs/auth.md "Tokens").
SOCKBOWL_AUTH_AUDIENCE=sockbowl-api

# Access token lifespan (seconds) for the sockbowl-game and sockbowl-e2e
# Keycloak clients. Playwright's refresh-token spec restarts the stack with a
# short value (e.g. 60) to exercise token expiry quickly.
KC_ACCESS_TOKEN_LIFESPAN=300

# Authentication
# Two modes:
#   AUTH_ENABLED=false  -> guest mode, zero auth setup
#   AUTH_ENABLED=true   -> Keycloak-backed login + RBAC (roles, ownership, bans) (default,
#                          the supported path)
# This compose file is production-capable by default: CREATE_DEMO_ACCOUNTS and
# SOCKBOWL_E2E default to false, and Keycloak runs in `start` (not `start-dev`)
# mode. For local development or Playwright, use the dev/e2e overlay instead
# of changing these here (see README.md "Authentication modes"):
#   docker compose -p sockbowl-e2e -f docker-compose.yml -f docker-compose.dev.yml \
#     --profile full up -d
# which turns on demo accounts and a password-grant `sockbowl-e2e` client
# mapped to all four RBAC tiers, password demo123:
#   player2  -> player    (host/join games, browse packets)
#   testuser -> author    (create/generate questions)
#   moderator-> moderator (ban/unban users, manage taxonomy: categories/subcategories/difficulties, no admin console)
#   player1  -> admin     (everything)
# player3 keeps the realm-default `player` role.
AUTH_ENABLED=true

# Keycloak realm admin user (created during realm import)
KEYCLOAK_USER_USERNAME=admin
KEYCLOAK_USER_EMAIL=admin@sockbowl.com
KEYCLOAK_USER_FIRSTNAME=Admin
KEYCLOAK_USER_LASTNAME=User
KEYCLOAK_USER_PASSWORD=CHANGE_ME_KEYCLOAK_USER_PASSWORD

# Demo accounts. Leave false in production; the dev/e2e overlay sets this to
# true (see "Authentication modes" above). DEMO_PASSWORD is the password the
# RBAC loader (scripts/load-rbac.sh) sets for every demoUsers entry; it's only
# read when CREATE_DEMO_ACCOUNTS=true, so the default below is dev-only.
CREATE_DEMO_ACCOUNTS=false
DEMO_PASSWORD=demo123

# Direct-grant (password) Keycloak client for Playwright/CI to obtain tokens
# without driving the login UI. Never enable this in production; the dev/e2e
# overlay sets it to true. The RBAC loader creates the client when true and
# deletes it when false.
SOCKBOWL_E2E=false

# Lets scripts/check-secrets.sh be bypassed for the placeholder credentials
# above. Only the dev/e2e overlay (docker-compose.dev.yml) sets this to true;
# leave it false everywhere else.
ALLOW_INSECURE_DEFAULTS=false

# Sockbowl Game Service Configuration
SOCKBOWL_DATABASE=0
SOCKBOWL_KAFKA_GAME_TOPIC=game-session-topic
SOCKBOWL_GAME_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Sockbowl Questions Service Configuration
# AI provider for question generation: "openai" or "ollama" (local). Leave chat flags
# false to run without AI (manual packet authoring still works).
#
# PREREQUISITE (regardless of the chat provider above): questions' Neo4j vector store
# always embeds via Ollama, so the host's Ollama needs the embedding model pulled
# before the stack comes up, or the vector store init 404s and the service never
# reports healthy:
#   ollama pull mxbai-embed-large
# The embedding model name is fixed in sockbowl-questions' application.yml
# (spring.ai.ollama.embedding.options.model), not overridable from here yet.
SOCKBOWL_AI_PROVIDER=ollama
SOCKBOWL_AI_LOCAL_MODEL=gpt-oss:latest
OPENAI_API_KEY=
SPRING_AI_OPENAI_CHAT_ENABLED=false
SPRING_AI_OLLAMA_CHAT_ENABLED=false
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
SPRING_AI_OLLAMA_CHAT_OPTIONS_MODEL=gpt-oss:latest
SOCKBOWL_QUESTIONS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:7000
# The base compose file has no passthrough for these three (M7): only
# docker-compose.prod.yml's sockbowl-questions block sets them, since
# questions' Ollama embedding path needed no chat/embedding-model env at all
# before M7. Left unset here (dev never loads that overlay); see
# .env.prod.example for the full description.
#SPRING_AI_MODEL_CHAT=openai
#SPRING_AI_MODEL_EMBEDDING=openai
#SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.ai.vectorstore.neo4j.autoconfigure.Neo4jVectorStoreAutoConfiguration

# Rate limiting, quotas and abuse controls (M4, see docs/limits.md and
# README.md "Limits and quotas"). Redis-backed and shared by game and
# questions; questions reuses game's Redis host/port/DB below (kept in sync
# automatically — see docker-compose.yml's SOCKBOWL_REDIS_HOST comment on the
# sockbowl-questions service, not a separate variable here).
#
# Every variable below is commented out on purpose: uncommenting one
# overrides that service's built-in default (see docs/limits.md for the
# shipped defaults); leaving it commented lets the app use that default.
# docker-compose.dev.yml and docker-compose.limits-e2e.yml set several of
# these for you when those overlays are layered in — don't also set them
# here unless you want to override the overlay too.
SOCKBOWL_RATELIMIT_ENABLED=true
SOCKBOWL_QUOTA_ENABLED=true
#SOCKBOWL_RL_SERVICE_CLIENTS=sockbowl-game-backend
# Only needed behind a reverse proxy that sets X-Forwarded-*; see the
# "Client IP" note in docs/auth.md. Leave both unset (the default,
# "none") when game/questions are called directly, as this compose file does.
#
# The strategy accepts only "none" or "native" here — game and questions both
# refuse to start with "framework" (LimitsStartupValidator), because Spring's
# framework strategy trusts X-Forwarded-* from any client with no proxy-count
# or internal-proxies check at all. "native" additionally requires a
# non-blank SOCKBOWL_TRUSTED_PROXIES_REGEX (server.tomcat.remoteip.internal-
# proxies): an empty regex under "native" would trust every peer as a proxy,
# which the same startup validator also refuses.
#SOCKBOWL_FORWARD_HEADERS_STRATEGY=native
# The trusted-proxy regex. SOCKBOWL_INTERNAL_PROXIES is the M7 name;
# SOCKBOWL_TRUSTED_PROXIES_REGEX (M4) is still honoured as a fallback. Set one.
#SOCKBOWL_INTERNAL_PROXIES=192\.168\.0\.\d{1,3}
#SOCKBOWL_TRUSTED_PROXIES_REGEX=192\.168\.0\.\d{1,3}
# Which request header native forwarding trusts as the real client IP
# (server.tomcat.remoteip.remote-ip-header). Left unset, both apps default to
# x-forwarded-for.
#
# M7 (behind Cloudflare, via aa-caddy; D26): use native, with
# SOCKBOWL_INTERNAL_PROXIES anchored to match ONLY aa-caddy's own peer
# address (never a broad subnet or Cloudflare's ranges directly — aa-caddy is
# the actual TCP peer game/questions see), and set:
#SOCKBOWL_REMOTE_IP_HEADER=CF-Connecting-IP
# ...or, as an alternative to the app trusting a Cloudflare-specific header
# directly, have Caddy itself rewrite X-Forwarded-For from {client_ip} with
# `trusted_proxies cloudflare`, and leave SOCKBOWL_REMOTE_IP_HEADER unset
# (x-forwarded-for default).
#
# Either way, this is safe ONLY with Cloudflare Authenticated Origin Pulls
# enforced at aa-caddy AND the game/questions ports not reachable from
# outside the host (see docs/auth.md "Client IP and reverse proxies") —
# without both, a client can spoof whichever header is trusted directly
# against the origin and bypass every per-IP rate limit and quota.
# Per-policy capacity / refill-period overrides. Uncomment and adjust
# individually; each is a bare "<capacity>/<refill period>" pair, e.g. "5"
# and "10m" below means 5 tokens refilling fully every 10 minutes. See
# docs/limits.md for what each policy applies to and its shipped default.
#
# Game policies:
#SOCKBOWL_RL_DEFAULT_CAPACITY=120
#SOCKBOWL_RL_DEFAULT_REFILL_PERIOD=1m
#SOCKBOWL_RL_SESSION_CREATE_CAPACITY=5
#SOCKBOWL_RL_SESSION_CREATE_REFILL_PERIOD=10m
#SOCKBOWL_RL_SESSION_JOIN_CAPACITY=20
#SOCKBOWL_RL_SESSION_JOIN_REFILL_PERIOD=1m
#SOCKBOWL_RL_WS_CONNECT_CAPACITY=10
#SOCKBOWL_RL_WS_CONNECT_REFILL_PERIOD=1m
#SOCKBOWL_RL_STOMP_SEND_IP_CAPACITY=120
#SOCKBOWL_RL_STOMP_SEND_IP_REFILL_PERIOD=1s
#SOCKBOWL_RL_STOMP_BUZZ_CAPACITY=5
#SOCKBOWL_RL_STOMP_BUZZ_REFILL_PERIOD=1s
#
# Questions policies (SOCKBOWL_RL_DEFAULT_* above is shared with game):
#SOCKBOWL_RL_GRAPHQL_READ_CAPACITY=240
#SOCKBOWL_RL_GRAPHQL_READ_REFILL_PERIOD=1m
#SOCKBOWL_RL_GRAPHQL_WRITE_CAPACITY=60
#SOCKBOWL_RL_GRAPHQL_WRITE_REFILL_PERIOD=1m
#SOCKBOWL_RL_AI_GENERATE_CAPACITY=10
#SOCKBOWL_RL_AI_GENERATE_REFILL_PERIOD=1h
#SOCKBOWL_RL_IMPORT_CAPACITY=10
#SOCKBOWL_RL_IMPORT_REFILL_PERIOD=1h
# Per-tier hosted-session quota overrides (game; -1 means unlimited).
# Defaults: guest 2, player 3, author/moderator 5, admin unlimited.
#SOCKBOWL_QUOTA_GUEST_HOSTED_SESSIONS=2
#SOCKBOWL_QUOTA_PLAYER_HOSTED_SESSIONS=3
#SOCKBOWL_QUOTA_AUTHOR_HOSTED_SESSIONS=5
#SOCKBOWL_QUOTA_MODERATOR_HOSTED_SESSIONS=5
# The global per-day budget for server-key AI generations, and the allowed
# model list when the server key (not the caller's own) is used.
SOCKBOWL_AI_SERVER_DAILY_BUDGET=200
#SOCKBOWL_AI_SERVER_ALLOWED_MODELS=gpt-oss:latest

# Memory limits (DK-1). The prod VPS is SHARED and has 7.6 GiB with no swap
# unless D27's 2 GiB swapfile is in place, so every sockbowl container gets a
# hard ceiling there. Each SOCKBOWL_<SERVICE>_MEM_LIMIT defaults to 0, which
# means unlimited and renders no limit at all (dev is unchanged). A limit is
# only safe together with the matching in-process cap, because Kafka, Neo4j
# and the JVMs otherwise size themselves from HOST memory and get OOM-killed:
#   service     limit   cap that must go with it
#   kafka       640m    KAFKA_HEAP_OPTS=-Xms384m -Xmx384m (image default -Xmx1G)
#   postgres    256m    none needed (shared_buffers default 128MB)
#   redis       192m    SOCKBOWL_REDIS_MAXMEMORY=128mb (noeviction; RDB saves
#                       fork, so leave ~1/3 of the limit as headroom)
#   neo4j       1600m   NEO4J_server_memory_heap_max__size=512m and
#                       NEO4J_server_memory_pagecache_size=384m
#   keycloak    900m    none needed (the image caps heap at 70% of the limit)
#   game        1000m   the buildpack's memory calculator derives -Xmx from
#                       the limit minus metaspace, code cache and
#                       SOCKBOWL_GAME_JVM_THREAD_COUNT x 1 MB stacks (default
#                       250). Keep the count >= the real peak thread count
#                       (Tomcat's 200 max + client pools) or native memory can
#                       exceed the budget; lower it only after measuring.
#                       WP-D3 live-verify (against a real container, a real
#                       mem_limit and this build's actual ~33k loaded
#                       classes): the calculator's own FIXED 240M
#                       -XX:ReservedCodeCacheSize (a JVM default it does not
#                       shrink) plus this build's ~200M metaspace plus 250
#                       thread stacks left only -Xmx3035K at the originally
#                       documented 700m/no-cap combination -- an immediate,
#                       reproducible OutOfMemoryError on every boot, not a
#                       tail-risk. SOCKBOWL_GAME_JAVA_TOOL_OPTIONS below caps
#                       the code cache explicitly instead of leaving it at
#                       the JVM default, and the limit is raised on top of
#                       that for a working ~415M heap -- confirmed booting.
#   questions   950m    same, with SOCKBOWL_QUESTIONS_JVM_THREAD_COUNT; carry
#                       the old prod override's JAVA_TOOL_OPTIONS and
#                       BPL_JVM_THREAD_COUNT over (plans/m7-deploy.md §4.3) via
#                       SOCKBOWL_QUESTIONS_JAVA_TOOL_OPTIONS / _JVM_THREAD_COUNT
#                       (also live-verified starved at the old 750m/no-cap
#                       combination -- it booted, at only ~72M heap, too thin
#                       to trust under real GraphQL/Neo4j/generation load;
#                       950m + the same code-cache cap gives ~300M).
#   ng          64m     none needed (nginx)
# Sum of limits: ~5.05 GiB of ceilings (raised +550m by the game/questions
# live-verify fix above from the originally planned ~4.5 GiB); expected
# steady use is correspondingly higher than the original ~3.3 GiB estimate.
# Check `docker stats` after the first real game and lower anything far below
# its limit before raising anything else -- this has not yet been checked
# against the real VPS's RAM (L1/V1's job); D27's 2 GiB swap is the backstop
# if it doesn't fit. An OOM kill shows as exit code 137 and OOMKilled=true in
# `docker inspect`.
#SOCKBOWL_KAFKA_MEM_LIMIT=640m
#KAFKA_HEAP_OPTS=-Xms384m -Xmx384m
#SOCKBOWL_POSTGRES_MEM_LIMIT=256m
#SOCKBOWL_REDIS_MEM_LIMIT=192m
#SOCKBOWL_REDIS_MAXMEMORY=128mb
#SOCKBOWL_NEO4J_MEM_LIMIT=1600m
#NEO4J_server_memory_heap_initial__size=512m
#NEO4J_server_memory_heap_max__size=512m
#NEO4J_server_memory_pagecache_size=384m
#SOCKBOWL_KEYCLOAK_MEM_LIMIT=900m
#SOCKBOWL_GAME_MEM_LIMIT=1000m
#SOCKBOWL_GAME_JVM_THREAD_COUNT=250
#SOCKBOWL_GAME_JAVA_TOOL_OPTIONS=-XX:ReservedCodeCacheSize=128m
# Netty direct-memory cap (always applied; the buildpack default is 10M).
#SOCKBOWL_GAME_MAX_DIRECT_MEMORY=64m
#SOCKBOWL_QUESTIONS_MEM_LIMIT=950m
#SOCKBOWL_QUESTIONS_JVM_THREAD_COUNT=250
#SOCKBOWL_QUESTIONS_JAVA_TOOL_OPTIONS=-XX:ReservedCodeCacheSize=128m
#SOCKBOWL_QUESTIONS_MAX_DIRECT_MEMORY=64m
#SOCKBOWL_NG_MEM_LIMIT=64m

# Sockbowl ng (nginx) Content-Security-Policy
# Extra connect-src origins beyond game/questions/Keycloak (which nginx adds
# automatically from APP_PROTOCOL/WS_PROTOCOL/APP_HOST). Needed for the AI
# packet-generation tab to call an API directly from the browser with the
# user's own key. Leave empty to omit it from connect-src entirely.
CSP_EXTRA_CONNECT_SRC=https://api.openai.com

# Watchtower / Docker socket
# Path to the Docker socket on the HOST, bind-mounted into watchtower
# (opt-in "autoupdate" profile only — see README.md "Watchtower / Docker
# socket"; containrrr/watchtower is archived upstream).
# Default assumes rootful Docker (the common case: Docker Desktop, most Linux installs,
# `sudo systemctl enable docker`). If your host runs rootless Docker instead, set:
#   DOCKER_SOCKET_PATH=${XDG_RUNTIME_DIR}/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Local image overrides
# By default the "full" profile pulls the published GHCR images (:main, built by CI).
# To run the full profile against images you built locally instead
# (`./gradlew bootBuildImage` in game/questions, `docker build` in ng), point these
# at your local tags, e.g. SOCKBOWL_GAME_IMAGE=sockbowl-game:local — or layer
# docker-compose.build.yml, which does this for you (see its header comment).
SOCKBOWL_GAME_IMAGE=ghcr.io/jacob-sabella/sockbowl-game:main
SOCKBOWL_QUESTIONS_IMAGE=ghcr.io/jacob-sabella/sockbowl-questions:main
SOCKBOWL_NG_IMAGE=ghcr.io/jacob-sabella/sockbowl-ng:main
